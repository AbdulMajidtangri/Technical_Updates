# Copy to .env.local and fill in your values (never commit .env.local)

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/personal-assistant

# OpenAI — get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
AI_BATCH_SIZE=5

# Secret for admin sync / cron routes
CRON_SECRET=your-cron-secret-here
