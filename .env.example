# Copy to .env.local and fill in your values (never commit .env.local)

# MongoDB — the app reads MONGODB_URI (MONGO_URI also works as fallback)
# Use ONE active line at a time, then restart: npm run dev

# --- Local MongoDB (development) ---
MONGODB_URI=mongodb://127.0.0.1:27017/personal-assistant

# --- MongoDB Atlas (production / cloud) ---
# Copy the mongodb+srv:// string from Atlas → Connect → Drivers (database name: techpulse-ai)
# MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/techpulse-ai?retryWrites=true&w=majority

# OpenAI — get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
AI_BATCH_SIZE=5

# Secret for admin sync / cron routes (use 32+ random bytes)
CRON_SECRET=your-cron-secret-here

# Optional separate secret for signing admin HttpOnly session cookies
ADMIN_SESSION_SECRET=your-admin-session-secret-here

# Production site URL for server-side fetch (safe to expose)
# NEXT_PUBLIC_APP_URL=https://your-domain.com

# --- Newsletter (paused until domain + SMTP email) ---
# Set FEATURES.newsletter = true in lib/config/features.js when ready, then add:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@domain.com
# SMTP_PASS=your-app-password
# SMTP_FROM=Inkwell Atlas <your@domain.com>
