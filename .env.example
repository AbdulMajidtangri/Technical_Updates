# MongoDB connection string
MONGODB_URI=

# OpenAI API key (server-side only - never use NEXT_PUBLIC_ prefix)
OPENAI_API_KEY=

# OpenAI model (optional, defaults to gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Batch size for AI processing (optional, defaults to 5)
AI_BATCH_SIZE=5

# Secret for protecting cron and admin endpoints
CRON_SECRET=

# Base URL for the application (optional, used in metadata)
NEXT_PUBLIC_APP_URL=http://localhost:3000
